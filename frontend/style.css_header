/* ==========================================================================
   0. Theme Variables (テーマ定数)
   ========================================================================== */
:root {
    /* Dark Mode (Default) */
    --bg-main: #1e1e1e;
    --bg-toolbar: #2d2d2d;
    --bg-input: #3c3c3c;
    --bg-sidebar: #252526;
    --bg-item-hover: rgba(255, 255, 255, 0.08);
    --bg-item-selected: rgba(0, 122, 204, 0.3);
    --text-main: #e0e0e0;
    --text-muted: #aaa;
    --text-bright: #ffffff;
    --border-main: #444;
    --border-light: rgba(255, 255, 255, 0.1);
    --accent-color: #007acc;
    --scrollbar-thumb: rgba(255, 255, 255, 0.2);
    --scrollbar-thumb-hover: rgba(255, 255, 255, 0.35);
    --glass-bg: rgba(45, 45, 45, 0.85);
    --tree-active: rgba(0, 122, 204, 0.2);

    /* Terminal */
    --bg-terminal: #0c0c0c;
    --text-terminal: #00ff00;
    --text-terminal-echo: #00ffff;
    --text-terminal-error: #ff5555;

    /* Icon Fills */
    --icon-folder: rgb(255, 212, 59);
    --icon-file: rgb(241, 242, 243);
    --icon-accent: #4facfe;

    /* Settings & Customization */
    --settings-sidebar-bg: #252526;
    --settings-main-bg: #1e1e1e;
    --main-font-size: 13px;
    --app-zoom: 1;
}

body {
    font-size: var(--main-font-size);
}

body.light-mode {
    --bg-main: #f8f9fa;
    --bg-toolbar: #ffffff;
    --bg-input: #e9ecef;
    --bg-sidebar: #f1f3f5;
    --bg-item-hover: rgba(0, 0, 0, 0.05);
    --bg-item-selected: rgba(0, 122, 204, 0.15);
    --text-main: #343a40;
    --text-muted: #6c757d;
    --text-bright: #000000;
    --border-main: #dee2e6;
    --border-light: rgba(0, 0, 0, 0.08);
    --accent-color: #007acc;
    --scrollbar-thumb: rgba(0, 0, 0, 0.2);
    --scrollbar-thumb-hover: rgba(0, 0, 0, 0.3);
    --glass-bg: rgba(255, 255, 255, 0.9);
    --tree-active: rgba(0, 122, 204, 0.1);

    /* Terminal */
    --bg-terminal: #ffffff;
    --text-terminal: #333333;
    --text-terminal-echo: #005cc5;
    --text-terminal-error: #d73a49;

    /* Icon Fills */
    --icon-folder: #e8a600;
    --icon-file: #555555;
    --icon-accent: #007acc;

    /* Settings & Customization */
    --settings-sidebar-bg: #f1f3f5;
    --settings-main-bg: #ffffff;
}

/* Deep Blue (深青) Theme */
body.theme-deepblue {
    --bg-main: #001b36;
    --bg-toolbar: #002142;
    --bg-input: #002b52;
    --bg-sidebar: #001529;
    --bg-item-hover: rgba(0, 162, 255, 0.15);
    --bg-item-selected: rgba(0, 162, 255, 0.3);
    --text-main: #e6f1ff;
    --text-muted: #8892b0;
    --text-bright: #ffffff;
    --border-main: #003366;
    --border-light: rgba(0, 162, 255, 0.1);
    --accent-color: #00a2ff;
    --scrollbar-thumb: rgba(0, 162, 255, 0.2);
    --scrollbar-thumb-hover: rgba(0, 162, 255, 0.4);
    --glass-bg: rgba(0, 21, 41, 0.85);
    --tree-active: rgba(0, 162, 255, 0.2);

    /* Terminal */
    --bg-terminal: #000c18;
    --text-terminal: #00d4ff;
    --text-terminal-echo: #64ffda;
    --text-terminal-error: #ff4d4d;

    /* Icon Fills */
    --icon-folder: #00a2ff;
    --icon-file: #8892b0;
    --icon-accent: #64ffda;

    /* Settings & Customization */
    --settings-sidebar-bg: #001529;
    --settings-main-bg: #001b36;
}

/* Khaki (カーキ) Theme */
body.theme-khaki {
    --bg-main: #2b2b1b;
    --bg-toolbar: #363622;
    --bg-input: #40402a;
    --bg-sidebar: #1f1f14;
    --bg-item-hover: rgba(194, 178, 128, 0.15);
    --bg-item-selected: rgba(194, 178, 128, 0.3);
    --text-main: #f5f5dc;
    --text-muted: #a8a878;
    --text-bright: #ffffff;
    --border-main: #45452e;
    --border-light: rgba(194, 178, 128, 0.1);
    --accent-color: #c2b280;
    --scrollbar-thumb: rgba(194, 178, 128, 0.2);
    --scrollbar-thumb-hover: rgba(194, 178, 128, 0.4);
    --glass-bg: rgba(31, 31, 20, 0.85);
    --tree-active: rgba(194, 178, 128, 0.2);

    /* Terminal */
    --bg-terminal: #1a1a10;
    --text-terminal: #d4d4aa;
    --text-terminal-echo: #c2b280;
    --text-terminal-error: #ff6b6b;

    /* Icon Fills */
    --icon-folder: #c2b280;
    --icon-file: #a8a878;
    --icon-accent: #f5f5dc;

    /* Settings & Customization */
    --settings-sidebar-bg: #1f1f14;
    --settings-main-bg: #2b2b1b;
}

/* Sakura (薄ピンク) Theme */
body.theme-sakura {
    --bg-main: #fffcfd;
    --bg-toolbar: #ffffff;
    --bg-input: #fffaff;
    --bg-sidebar: #fff5f8;
    --bg-item-hover: rgba(255, 182, 193, 0.15);
    --bg-item-selected: rgba(255, 182, 193, 0.3);
    --accent-color: #ffb6c1;
    --border-main: #ffe4e1;
    --border-light: rgba(255, 182, 193, 0.1);
    --tree-active: rgba(255, 182, 193, 0.15);
    --icon-accent: #ffb6c1;
    --settings-sidebar-bg: #fff5f8;
}

/* Amber (黄色系) Theme */
body.theme-amber {
    --bg-main: #fffbeb;
    --bg-toolbar: #ffffff;
    --bg-input: #fffcf0;
    --bg-sidebar: #fef3c7;
    --bg-item-hover: rgba(217, 119, 6, 0.1);
    --bg-item-selected: rgba(217, 119, 6, 0.2);
    --accent-color: #d97706;
    --border-main: #fde68a;
    --border-light: rgba(217, 119, 6, 0.1);
    --tree-active: rgba(217, 119, 6, 0.1);
    --icon-accent: #d97706;
    --settings-sidebar-bg: #fef3c7;
}

/* Sky (うっすい水色) Theme */
body.theme-sky {
    --bg-main: #f0f9ff;
    --bg-toolbar: #ffffff;
    --bg-input: #f5faff;
    --bg-sidebar: #e0f2fe;
    --bg-item-hover: rgba(14, 165, 233, 0.1);
    --bg-item-selected: rgba(14, 165, 233, 0.2);
    --accent-color: #0ea5e9;
    --border-main: #bae6fd;
    --border-light: rgba(14, 165, 233, 0.1);
    --tree-active: rgba(14, 165, 233, 0.1);
    --icon-accent: #0ea5e9;
    --settings-sidebar-bg: #e0f2fe;
}

{
  "name": "orbiter",
  "version": "2.1.0",
  "description": "A fast and modern file explorer for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.orbiter.app",
    "productName": "Orbiter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "../filer_server.exe",
        "to": "."
      }
    ],
    "files": [
      "**/*",
      "!dist"
    ]
  },
  "keywords": [
    "file-explorer",
    "electron",
    "windows"
  ],
  "author": "sugim",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.16.1",
    "png-to-ico": "^3.0.1"
  }
}
